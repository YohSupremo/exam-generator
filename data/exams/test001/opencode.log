; }\n101:                 if ($err) { fwrite($logHandle, $err); $output[] = $err; }\n102:                 $exitCode = $status['exitcode'];\n103:             } else {\n104:                 usleep(200000);\n105:             }\n106:         }\n107:         fclose($pipes[1]);\n108:         fclose($pipes[2]);\n109:         proc_close($proc);\n110:     } else {\n111:         fwrite($logHandle, \"FATAL: could not start opencode\\n\");\n112:         fclose($logHandle);\n113:         set_job_status($statusFile, 'error', 'Could not start opencode.', 'Could not start opencode process.');\n114:         exam_update($id, ['status' => 'error']);\n115:         exit(1);\n116:     }\n117:     fclose($logHandle);\n118: }\n119: \n120: app_log(\"Job $id: opencode exited with code $exitCode\");\n121: \n122: $data = null;\n123: if (is_file($outFile)) {\n124:     $data = json_decode((string)file_get_contents($outFile), true);\n125:     if (!is_array($data)) {\n126:         app_log(\"Job $id: questions.json is not valid JSON, trying log fallback\");\n127:         $data = extract_json_fallback($output);\n128:     }\n129: }\n130: \n131: if (!is_array($data) || !validate_bank($data)) {\n132:     $tail = '';\n133:     if (is_file($logFile)) {\n134:         $lines = file($logFile, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [];\n135:         $tail = implode(\"\\n\", array_slice($lines, -30));\n136:     }\n137:     file_put_contents(\n138:         $dir . '/status.json',\n139:         json_encode([\n140:             'status' => 'error',\n141:             'message' => 'No valid question bank was produced.',\n142:             'error' => 'opencode exited but produced no valid question bank JSON.',\n143:             'log_tail' => $tail,\n144:             'updated' => date('c'),\n145:         ], JSON_UNESCAPED_UNICODE)\n146:     );\n147:     exam_update($id, ['status' => 'error']);\n148:     app_log(\"Job $id: FAILED - no valid question bank\");\n149:     exit(1);\n150: }\n151: \n152: $data = nor