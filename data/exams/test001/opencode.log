{"type":"tool_use","timestamp":1789818360797,"sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","part":{"type":"tool","tool":"write","callID":"call_f528d4aba38e428a97350dde","state":{"status":"completed","input":{"content":"[\n  { \"chapterId\": \"ch1\", \"term\": \"EA Implementation Methodology\", \"definition\": \"A detailed, step-by-step approach that describes how an Enterprise Architecture program is established, developed, managed, maintained, and used within an organization.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"EA Framework\", \"definition\": \"A structured set of tools, models, and guidelines used to organize and design an enterprise's architecture, providing a common language and structure.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Zachman Framework\", \"definition\": \"A 6x6 classification schema (36 cells) developed by John Zachman in 1987; columns are What/How/Where/Who/When/Why and rows are Planner, Owner, Designer, Builder, Sub-Contractor, Enterprise. It is a reference checklist, not a methodology.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"TOGAF\", \"definition\": \"The Open Group Architecture Framework; helps organizations design, plan, implement, and manage enterprise architecture using the ADM cycle.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"ADM\", \"definition\": \"Architecture Development Method: the TOGAF method that identifies business requirements, analyzes current architecture, designs the target, identifies changes, plans implementation, and manages/reviews.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"FEAF\", \"definition\": \"Federal Enterprise Architecture Framework, developed by the U.S. Federal Government to organize and manage enterprise architecture, supported by six reference models (PRM, DRM, SRM, BRM, ARM, TRM).\" },\n  { \"chapterId\": \"ch1\", \"term\": \"PRM\", \"definition\": \"Performance Reference Model: measures how well an organization and its IT systems achieve strategic goals and desired outcomes.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"DRM\", \"definition\": \"Data Reference Model: defines how data is categorized, described, shared, and managed across the enterprise.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"SRM\", \"definition\": \"Security Reference Model: defines security-related capabilities, controls, and requirements for protecting enterprise systems and information.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"BRM\", \"definition\": \"Business Reference Model: describes the organization's business functions, services, and activities.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"ARM\", \"definition\": \"Application Reference Model: organizes IT services and application components that support business functions.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"TRM\", \"definition\": \"Technical Reference Model: provides a common structure for technologies, platforms, and technical standards used by the enterprise.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Gartner EA Methodology\", \"definition\": \"An EA methodology from Gartner that views EA as a continuous process of change and improvement, focused on business strategy, stakeholders, and outcomes rather than technology alone.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Business Architecture\", \"definition\": \"The foundation of the EA framework; defines the organization's business strategy, governance, structure, and key business processes.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Data (Information) Architecture\", \"definition\": \"The structure and management of an organization's logical and physical data assets and data management resources.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Application Architecture\", \"definition\": \"A blueprint for the individual applications' deployment, their interactions, and their relationships to core business processes.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Technology Architecture\", \"definition\": \"The hardware, software, and network infrastructure that provides the hosting and runtime environment for applications.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Architecture Artifact\", \"definition\": \"An architectural work product that describes an aspect of the architecture - deliverables, documents, diagrams, models, matrices, and catalogs produced throughout the EA lifecycle.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Catalogs (Artifact)\", \"definition\": \"A hierarchical list or inventory of things that answers 'What inventory do we have?' e.g., Application Portfolio Catalog.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Matrices (Artifact)\", \"definition\": \"A grid showing the relationship between two or more architectural elements, answering 'How do elements relate?' e.g., Application-to-Function Matrix.\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Diagrams / Models (Artifact)\", \"definition\": \"Visual representations of architecture components and their topology or dynamics, answering 'What does the structure or flow look like?'\" },\n  { \"chapterId\": \"ch1\", \"term\": \"Cross-Layer Traceability\", \"definition\": \"The rigorous link across Business -> Data -> Application -> Technology layers so every technical asset maps back to a business need; enables impact analysis, cost optimization, and strategic agility.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"As-Is State\", \"definition\": \"The current architectural view; a complete snapshot of a company's technology and processes right now, serving as the baseline and blueprint.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"EACR (EA Change Request)\", \"definition\": \"A standard format request used to update systems smoothly; archiving these requests creates a history guide for developers.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"IDEF-O\", \"definition\": \"A visual modeling technique that clearly shows inputs and outputs, the Controls (rules), and the Mechanisms (tools) of a process.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"ERD (Entity-Relationship Diagram)\", \"definition\": \"A diagram that defines how different parts of the business relate, e.g., how a Buyer connects to a Listing.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Future Architectural View\", \"definition\": \"Documentation of IT resources expected to be active several years ahead, used for resource planning, decision support, and enterprise-wide communication.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"CONOPS Scenario\", \"definition\": \"A Concept of Operations scenario documenting good and bad operating environments drawn from the SWOT Analysis to plan defensive and offensive initiatives in advance.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Storytelling Technique\", \"definition\": \"Dr. Robert Neilson's technique of writing a short story through the eyes of a central character living through future events, tied to assumptions in Process, People, and Technology.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Balanced Scorecard\", \"definition\": \"A strategic-level future-view artifact used to track goals such as 'Grow e-government service adoption 30% in 3 years.'\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Swim Lane Process Diagram\", \"definition\": \"A business-level future artifact tracing a process such as an application from Citizen -> Apply -> Portal -> Submit -> Records Office.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"CRUD Matrix\", \"definition\": \"An Activity/Entity matrix (Create, Read, Update, Delete) at the Information level, e.g., 'Permit Record' created by Intake, updated by Reviewer, deleted by Records Admin.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Freeze Periods\", \"definition\": \"Freezing current and future views at regular intervals (e.g., twice a year); changes accumulate for 4-5 months and publish as a new release in month six.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Baseline Architecture\", \"definition\": \"The current, 'as-is' structure of the enterprise; the starting point for any transformation in TOGAF.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Transition Architecture\", \"definition\": \"One or more intermediate states that bridge the gap between baseline and target on a realistic timeline.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Target Architecture\", \"definition\": \"The desired future state: capabilities, processes, and technologies aligned to strategic goals.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"EA Management Plan\", \"definition\": \"A living document guiding the transition from the current architecture to the desired future architecture; coordinates IT projects, resources, standards, governance, and implementation.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Chief Architect\", \"definition\": \"The person who manages the EA program, documentation, standards, and configuration management.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Outcome Measures\", \"definition\": \"Performance measures reflecting improvements in integration, user satisfaction, or IT investment decisions.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Output Measures\", \"definition\": \"Performance measures counting number of projects completed, scope changes, or planning activities.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"EA Sequencing Plan\", \"definition\": \"A plan listing projects, tasks, milestones, dependencies, and timeframes to ensure projects occur in the correct order.\" },\n  { \"chapterId\": \"ch2\", \"term\": \"Configuration Management\", \"definition\": \"Reviews and controls proposed EA changes, applies technical standards, manages waivers, and maintains documentation and version control.\" }\n]","filePath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\enc_part1.json"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\enc_part1.json","exists":false,"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\enc_part1.json","time":{"start":1789818360756,"end":1789818360775}},"id":"prt_0b97c9778001Z9brQx7e4VM9XU","sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","messageID":"msg_0b97c9166001TxorYDZK1X6ipK"}}
