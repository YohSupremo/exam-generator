{"type":"tool_use","timestamp":1789817799533,"sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","part":{"type":"tool","tool":"read","callID":"call_8b1207bc9eba4d9191933697","state":{"status":"completed","input":{"filePath":"C:\\xampp\\htdocs\\automation\\side-project\\assets\\exam-app.js"},"output":"<path>C:\\xampp\\htdocs\\automation\\side-project\\assets\\exam-app.js</path>\n<type>file</type>\n<content>\n1: (function () {\n2:   \"use strict\";\n3: \n4:   const examId = document.body.dataset.examId;\n5:   const view = document.getElementById(\"view\");\n6:   const navEl = document.getElementById(\"exam-nav\");\n7: \n8:   let bank = null;\n9:   let flat = []; // [{ch, q}]\n10:   let currentView = null; // 'ch|ch1' | 'overall' | 'answerkey' | 'encyclopedia'\n11: \n12:   const LETTERS = [\"A\", \"B\", \"C\", \"D\"];\n13: \n14:   // chapterState[ch.chapterId] = {mode, started, completed, order[], index, score, correct, incorrect, answers{}, choiceOrder{}, timer}\n15:   const chapterState = {};\n16:   let overall = null; // {started, submitted, selected{}, score, correct, incorrect}\n17: \n18:   /* ---------------- helpers ---------------- */\n19: \n20:   function shuffle(arr) {\n21:     const a = arr.slice();\n22:     for (let i = a.length - 1; i > 0; i--) {\n23:       const j = Math.floor(Math.random() * (i + 1));\n24:       [a[i], a[j]] = [a[j], a[i]];\n25:     }\n26:     return a;\n27:   }\n28: \n29:   function esc(s) {\n30:     return String(s == null ? \"\" : s)\n31:       .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")\n32:       .replace(/\"/g, \"&quot;\");\n33:   }\n34: \n35:   function toast(msg) {\n36:     const t = document.createElement(\"div\");\n37:     t.className = \"toast\";\n38:     t.textContent = msg;\n39:     document.body.appendChild(t);\n40:     setTimeout(function () { t.remove(); }, 2600);\n41:   }\n42: \n43:   function activeLock() {\n44:     if (overall && overall.started && !overall.submitted) return \"overall\";\n45:     for (const ch of bank.chapters) {\n46:       const s = chapterState[ch.chapterId];\n47:       if (s && s.started && !s.completed) return ch.chapterId;\n48:     }\n49:     return null;\n50:   }\n51: \n52:   function chapterById(id) {\n53:     return bank.chapters.find(function (c) { return c.chapterId === id; }) || null;\n54:   }\n55: \n56:   /* ---------------- data loading ---------------- */\n57: \n58:   function load() {\n59:     fetch(\"api/data.php?id=\" + encodeURIComponent(examId))\n60:       .then(function (r) {\n61:         if (!r.ok) throw new Error(\"HTTP \" + r.status);\n62:         return r.json();\n63:       })\n64:       .then(function (data) {\n65:         if (!data || !Array.isArray(data.chapters) || !data.chapters.length) {\n66:           throw new Error(\"Question bank is empty or malformed\");\n67:         }\n68:         bank = data;\n69:         flat = [];\n70:         data.chapters.forEach(function (ch) {\n71:           ch.questions.forEach(function (q) { flat.push({ ch: ch, q: q }); });\n72:         });\n73:         document.title = data.title || document.title;\n74:         renderHeader();\n75:         renderNav();\n76:         switchTo(\"ch|\" + data.chapters[0].chapterId);\n77:       })\n78:       .catch(function (err) {\n79:         view.innerHTML = '<div class=\"view-panel\"><div class=\"panel-title\">Failed to load exam</div>' +\n80:           '<p class=\"muted\">' + esc(err.message) + '</p></div>';\n81:       });\n82:   }\n83: \n84:   function renderHeader() {\n85:     document.getElementById(\"exam-title\").textContent = bank.title || \"Exam\";\n86:     const meta = [];\n87:     if (bank.subject) meta.push(bank.subject);\n88:     meta.push(bank.chapters.length + \" chapters\");\n89:     meta.push(flat.length + \" questions\");\n90:     if (bank.summary) meta.push(bank.summary);\n91:     document.getElementById(\"exam-meta\").innerHTML = meta.map(function (m) {\n92:       return \"<span>\" + esc(m) + \"</span>\";\n93:     }).join(\" &middot; \");\n94:   }\n95: \n96:   /* ---------------- navigation ---------------- */\n97: \n98:   function renderNav() {\n99:     const lock = activeLock();\n100:     navEl.innerHTML = \"\";\n101:     navEl.appendChild(inlineContainer());\n102: \n103:     bank.chapters.forEach(function (ch) {\n104:       const s = chapterState[ch.chapterId];\n105:       const done = s && s.completed;\n106:       const btn = makeTab(\n107:         ch.title,\n108:         \"ch|\" + ch.chapterId,\n109:         done ? '<span class=\"chk\" aria-hidden=\"true\">\\u2713</span>' : \"\",\n110:         lock && lock !== ch.chapterId,\n111:         lock === ch.chapterId && !done\n112:       );\n113:       navEl.appendChild(btn);\n114:     });\n115: \n116:     navEl.appendChild(makeTab(\"Overall Exam\", \"overall\", overall && overall.submitted ? '<span class=\"chk\">\\u2713</span>' : \"\", lock === \"overall\" || (lock && lock !== \"overall\"), false));\n117:     navEl.appendChild(makeTab(\"Answer Key\", \"answerkey\", \"\", lock !== null, false));\n118:     navEl.appendChild(makeTab(\"Encyclopedia\", \"encyclopedia\", \"\", lock !== null, false));\n119:   }\n120: \n121:   function inlineContainer() {\n122:     const c = document.createElement(\"div\");\n123:     c.className = \"container\";\n124:     return c;\n125:   }\n126: \n127:   function makeTab(label, viewKey, suffix, locked, active) {\n128:     const b = document.createElement(\"button\");\n129:     b.className = \"nav-tab\";\n130:     if (active) b.classList.add(\"active\");\n131:     b.innerHTML = esc(label) + \" \" + (suffix || \"\");\n132:     if (locked) {\n133:       b.disabled = true;\n134:     } else {\n135:       b.addEventListener(\"click\", function () { switchTo(viewKey); });\n136:     }\n137:     return b;\n138:   }\n139: \n140:   function switchTo(key) {\n141:     const lock = activeLock();\n142:     if (lock && lock !== \"overall\" && key !== \"ch|\" + lock) {\n143:       const ch = chapterById(lock);\n144:       toast(\"Finish or reset \\u201c\" + (ch ? ch.title : lock) + \"\\u201d first to switch sections.\");\n145:       renderNav(); // re-affirm lock state\n146:       return;\n147:     }\n148:     if (lock === \"overall\" && key !== \"overall\") {\n149:       toast(\"Finish or submit the Overall Exam first to switch sections.\");\n150:       renderNav();\n151:       return;\n152:     }\n153:     currentView = key;\n154:     renderNav();\n155:     if (key === \"overall\") renderOverall();\n156:     else if (key === \"answerkey\") renderAnswerKey();\n157:     else if (key === \"encyclopedia\") renderEncyclopedia();\n158:     else if (key.indexOf(\"ch|\") === 0) renderChapter(key.slice(3));\n159:     else renderHome();\n160:   }\n161: \n162:   /* ---------------- chapter render ---------------- */\n163: \n164:   function freshChapterState(chId) {\n165:     const ch = chapterById(chId);\n166:     const order = shuffle(ch.questions.map(function (q) { return q.id; }));\n167:     const choiceOrder = {};\n168:     ch.questions.forEach(function (q) {\n169:       choiceOrder[q.id] = shuffle([0, 1, 2, 3]);\n170:     });\n171:     chapterState[chId] = {\n172:       mode: null,\n173:       started: false,\n174:       completed: false,\n175:       order: order,\n176:       index: 0,\n177:       score: 0,\n178:       correct: 0,\n179:       incorrect: 0,\n180:       answers: {},\n181:       choiceOrder: choiceOrder,\n182:       timer: null,\n183:     };\n184:   }\n185: \n186:   function getChapterState(chId) {\n187:     if (!chapterState[chId]) freshChapterState(chId);\n188:     return chapterState[chId];\n189:   }\n190: \n191:   function clearTimer(st) {\n192:     if (st.timer) {\n193:       clearInterval(st.timer);\n194:       st.timer = null;\n195:     }\n196:   }\n197: \n198:   function renderChapter(chId) {\n199:     const ch = chapterById(chId);\n200:     const st = getChapterState(chId);\n201: \n202:     if (st.completed) {\n203:       renderChapterResults(chId);\n204:       return;\n205:     }\n206:     if (!st.started || !st.mode) {\n207:       renderModeSelect(ch);\n208:       return;\n209:     }\n210:     renderQuestion(ch);\n211:   }\n212: \n213:   function renderModeSelect(ch) {\n214:     const st = getChapterState(ch.chapterId);\n215:     view.innerHTML =\n216:       '<div class=\"view-panel\">' +\n217:       '<h2 class=\"panel-title\">' + esc(ch.title) + '</h2>' +\n218:       '<p class=\"panel-sub\">' + esc(ch.description || \"\") + \"</p>\" +\n219:       '<div class=\"card start-card\">' +\n220:       '<p class=\"muted\">' + ch.questions.length + \" questions</p>\" +\n221:       '<p style=\"margin:0 0 4px;font-size:14px;\"><strong>Choose your mode</strong></p>' +\n222:       '<div class=\"mode-grid\">' +\n223:       '<div class=\"mode-option ' + (st.mode === \"timed\" ? \"selected\" : \"\") + '\" data-mode=\"timed\" role=\"button\" tabindex=\"0\" aria-pressed=\"' + (st.mode === \"timed\") + '\">' +\n224:       \"<h4>Timed</h4><p>10 seconds per question. Timeout counts as incorrect.</p></div>\" +\n225:       '<div class=\"mode-option ' + (st.mode === \"untimed\" ? \"selected\" : \"\") + '\" data-mode=\"untimed\" role=\"button\" tabindex=\"0\" aria-pressed=\"' + (st.mode === \"untimed\") + '\">' +\n226:       \"<h4>Untimed</h4><p>No time limit at all.</p></div>\" +\n227:       \"</div>\" +\n228:       '<button class=\"btn btn-primary\" id=\"start-id\">Start Chapter</button>' +\n229:       '<button class=\"btn\" id=\"shuffle-again\" style=\"margin-left:10px;\">Shuffle Questions</button>' +\n230:       \"</div></div>\";\n231: \n232:     view.querySelectorAll(\".mode-option\").forEach(function (el) {\n233:       const pick = function () {\n234:         st.mode = el.dataset.mode;\n235:         view.querySelectorAll(\".mode-option\").forEach(function (o) {\n236:           o.classList.toggle(\"selected\", o === el);\n237:           o.setAttribute(\"aria-pressed\", o === el ? \"true\" : \"false\");\n238:         });\n239:       };\n240:       el.addEventListener(\"click\", pick);\n241:       el.addEventListener(\"keydown\", function (e) {\n242:         if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); pick(); }\n243:       });\n244:     });\n245: \n246:     document.getElementById(\"shuffle-again\").addEventListener(\"click\", function () {\n247:       freshChapterState(ch.chapterId);\n248:       renderModeSelect(ch);\n249:     });\n250: \n251:     document.getElementById(\"start-id\").addEventListener(\"click\", function () {\n252:       if (!st.mode) {\n253:         toast(\"Choose Timed or Untimed first.\");\n254:         return;\n255:       }\n256:       st.started = true;\n257:       st.index = 0;\n258:       renderNav();\n259:       renderChapter(ch.chapterId);\n260:     });\n261:   }\n262: \n263:   function currentQ(ch, st, displayIndex) {\n264:     const qid = st.order[displayIndex];\n265:     const q = ch.questions.find(function (x) { return x.id === qid; });\n266:     return q;\n267:   }\n268: \n269:   function renderQuestion(ch) {\n270:     const st = getChapterState(ch.chapterId);\n271:     const pos = st.index;\n272:     const q = currentQ(ch, st, pos);\n273:     if (!q) {\n274:       completeChapter(ch.chapterId);\n275:       return;\n276:     }\n277: \n278:     const total = ch.questions.length;\n279:     const displayNum = pos + 1;\n280:     const answered = st.answers[q.id];\n281:     const choiceOrder = st.choiceOrder[q.id];\n282:     const isTimed = st.mode === \"timed\";\n283:     const pct = Math.round((pos / total) * 100);\n284: \n285:     let html =\n286:       '<div class=\"view-panel\">' +\n287:       '<div class=\"q-header\">' +\n288:       '<div>' +\n289:       '<div class=\"q-progress-label\">' + esc(ch.title) + \" &middot; Question \" + displayNum + \" of \" + total + \" &middot; Progress: \" + pct + \"%</div>\" +\n290:       \"</div>\" +\n291:       '<div class=\"q-header-right\">' +\n292:       (isTimed ? '<span class=\"timer\" data-timer>10</span>' : \"\") +\n293:       '<span class=\"q-score\">Score: ' + st.correct + \"/\" + st.answered + \"</span>\" +\n294:       \"</div></div>\" +\n295:       '<div class=\"q-progress\"><div style=\"width:' + pct + '%\"></div></div>' +\n296:       '<div class=\"q-card\">' +\n297:       '<p class=\"q-text\">' + esc(q.question) + \"</p>\";\n298: \n299:     html += '<ul class=\"choices\">';\n300:     for (let i = 0; i < 4; i++) {\n301:       const origIdx = choiceOrder[i];\n302:       const cls = [];\n303:       if (answered) {\n304:         if (origIdx === q.correctAnswer) cls.push(\"correct\");\n305:         if (answered.selected === origIdx && origIdx !== q.correctAnswer) cls.push(\"incorrect\");\n306:       }\n307:       html += '<li><button class=\"choice ' + cls.join(\" \") + '\" data-choice=\"' + i + '\"' + (answered ? \" disabled\" : \"\") + \">\" +\n308:         '<span class=\"letter\">' + LETTERS[i] + \"</span>\" +\n309:         '<span class=\"choice-text\">' + esc(q.choices[origIdx]) + \"</span></button></li>\";\n310:     }\n311:     html += \"</ul>\";\n312: \n313:     if (answered) {\n314:       let cls = \"correct\", title = \"Correct!\", expl = esc(q.explanation);\n315:       if (answered.timedOut) { cls = \"timeout\"; title = \"Time's up!\"; }\n316:       else if (!answered.correct) { cls = \"incorrect\"; title = \"Incorrect.\"; }\n317:       html += '<div class=\"feedback ' + cls + '\"><span class=\"fb-title\">' + title + \"</span>\" +\n318:         \"<strong>Correct answer: \" + LETTERS[choiceOrder.indexOf(q.correctAnswer)] + \".</strong> \" +\n319:         \"<span>\" + expl + \"</span></div>\";\n320:       if (answered.timedOut) {\n321:         html += \"<p style=\\\"color:var(--muted);font-size:13px;\\\">Out of time &mdash; counted as incorrect. Score: \" +\n322:           st.correct + \"/\" + (st.correct + st.incorrect) + \".</p>\";\n323:       }\n324:       html += '<div class=\"next-row\"><button class=\"btn btn-primary\" id=\"next-btn\">' +\n325:         (pos + 1 >= total ? \"Finish Chapter\" : \"Next Question\") + \"</button></div>\";\n326:     }\n327: \n328:     html += \"</div>\" +\n329:       '<div class=\"next-row\"><button class=\"reset-link\" id=\"reset-link\">Reset chapter (choose mode again)</button></div>' +\n330:       \"</div>\";\n331: \n332:     view.innerHTML = html;\n333: \n334:     if (!answered) {\n335:       const idxQid = q.id;\n336:       view.querySelectorAll(\".choice\").forEach(function (btn) {\n337:         btn.addEventListener(\"click\", function () {\n338:           const choiceIdx = parseInt(btn.dataset.choice, 10);\n339:           const origIdx = st.choiceOrder[idxQid][choiceIdx];\n340:           answerChapterCurrent(ch.chapterId, idxQid, origIdx, choiceIdx);\n341:         });\n342:       });\n343:     } else {\n344:       document.getElementById(\"next-btn\").addEventListener(\"click\", function () {\n345:         clearTimer(st);\n346:         st.index += 1;\n347:         renderChapter(ch.chapterId);\n348:       });\n349:     }\n350: \n351:     document.getElementById(\"reset-link\").addEventListener(\"click\", function () {\n352:       if (confirm(\"Reset this chapter? Your score and progress will be cleared, and you can pick a new mode.\")) {\n353:         resetChapter(ch.chapterId);\n354:       }\n355:     });\n356: \n357:     if (!answered && isTimed) {\n358:       startTimer(ch.chapterId, q.id);\n359:     }\n360:   }\n361: \n362:   function startTimer(chId, qid) {\n363:     const st = getChapterState(chId);\n364:     clearTimer(st);\n365:     let left = 10;\n366:     const el = view.querySelector(\"[data-timer]\");\n367:     if (el) { el.textContent = left; el.classList.remove(\"low\"); }\n368: \n369:     st.timer = setInterval(function () {\n370:       // guard: only tick if the locked chapter is still this one\n371:       if (activeLock() !== chId) {\n372:         clearInterval(st.timer);\n373:         st.timer = null;\n374:         return;\n375:       }\n376:       if (!st.answers[qid]) {\n377:         left -= 1;\n378:         if (el) {\n379:           el.textContent = Math.max(0, left);\n380:           el.classList.toggle(\"low\", left <= 3);\n381:         }\n382:         if (left <= 0) {\n383:           clearInterval(st.timer);\n384:           st.timer = null;\n385:           answerChapterTimeout(chId, qid);\n386:         }\n387:       }\n388:     }, 1000);\n389:   }\n390: \n391:   function answerChapterCurrent(chId, qid, origIdx, choiceIdx) {\n392:     const st = getChapterState(chId);\n393:     const q = chapterById(chId).questions.find(function (x) { return x.id === qid; });\n394:     const correct = origIdx === q.correctAnswer;\n395:     st.answers[qid] = { selected: origIdx, correct: correct, timedOut: false, at: choiceIdx };\n396:     st.answered = Object.keys(st.answers).length;\n397:     if (correct) { st.correct += 1; st.score += 1; } else { st.incorrect += 1; }\n398:     clearTimer(st);\n399:     renderChapter(chId);\n400:   }\n401: \n402:   function answerChapterTimeout(chId, qid) {\n403:     const st = getChapterState(chId);\n404:     if (st.answers[qid]) return; // already answered\n405:     st.answers[qid] = { selected: null, correct: false, timedOut: true, at: null };\n406:     st.answered = Object.keys(st.answers).length;\n407:     st.incorrect += 1;\n408:     renderChapter(chId);\n409:   }\n410: \n411:   function completeChapter(chId) {\n412:     const st = getChapterState(chId);\n413:     st.completed = true;\n414:     clearTimer(st);\n415:     renderNav();\n416:     renderChapterResults(chId);\n417:   }\n418: \n419:   function resetChapter(chId) {\n420:     const st = getChapterState(chId);\n421:     clearTimer(st);\n422:     freshChapterState(chId);\n423:     renderNav();\n424:     renderChapter(chId);\n425:   }\n426: \n427:   function renderChapterResults(chId) {\n428:     const ch = chapterById(chId);\n429:     const st = getChapterState(chId);\n430:     const total = ch.questions.length;\n431:     const pct = total ? Math.round((st.correct / total) * 100) : 0;\n432: \n433:     view.innerHTML =\n434:       '<div class=\"view-panel\">' +\n435:       '<h2 class=\"panel-title\">Chapter complete</h2>' +\n436:       '<p class=\"panel-sub\">' + esc(ch.title) + \"</p>\" +\n437:       '<div class=\"card\">' +\n438:       '<div class=\"result-big\">' + pct + \"%</div>\" +\n439:       '<div class=\"result-grid\">' +\n440:       '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--green)\">' + st.correct + \"</span><span class=\\\"rc-label\\\">Correct</span></div>\" +\n441:       '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--red)\">' + st.incorrect + \"</span><span class=\\\"rc-label\\\">Incorrect</span></div>\" +\n442:       '<div class=\"result-cell\"><span class=\"rc-value\">' + st.correct + \"/\" + total + \"</span><span class=\\\"rc-label\\\">Score</span></div>\" +\n443:       '<div class=\"result-cell\"><span class=\"rc-value\">' + (st.mode === \"timed\" ? \"Timed\" : \"Untimed\") + \"</span><span class=\\\"rc-label\\\">Mode</span></div>\" +\n444:       \"</div>\" +\n445:       '<div class=\"result-actions\">' +\n446:       '<button class=\"btn btn-primary\" id=\"review-btn\">Review Answers</button>' +\n447:       '<button class=\"btn\" id=\"retake-btn\">Retake (reset)</button>' +\n448:       '<button class=\"btn\" id=\"again-btn\">Shuffle &amp; Retake</button>' +\n449:       \"</div></div></div>\";\n450: \n451:     document.getElementById(\"review-btn\").addEventListener(\"click\", function () {\n452:       renderReview(chId);\n453:     });\n454:     document.getElementById(\"retake-btn\").addEventListener(\"click\", function () {\n455:       resetChapter(chId);\n456:     });\n457:     document.getElementById(\"again-btn\").addEventListener(\"click\", function () {\n458:       freshChapterState(chId);\n459:       renderModeSelect(ch);\n460:     });\n461:   }\n462: \n463:   function renderReview(chId) {\n464:     const ch = chapterById(chId);\n465:     const st = getChapterState(chId);\n466:     const items = ch.questions.map(function (q) {\n467:       const a = st.answers[q.id];\n468:       const chosen = a ? a.selected : null;\n469:       const ok = !!(a && a.correct);\n470:       const verdict = ok ? \"Correct\" : (a && a.timedOut ? \"Time's up (incorrect)\" : \"Incorrect\");\n471:       const letter = a && a.at != null ? LETTERS[a.at] : \"-\";\n472:       return (\n473:         '<div class=\"review-item\">' +\n474:         '<p class=\"rq\">' + esc(q.question) + \"</p>\" +\n475:         '<div class=\"ans-line\"><span class=\"' + (ok ? \"ok\" : \"no\") + '\">' + verdict + \"</span> &mdash; Your answer: <strong>\" +\n476:         (chosen == null ? \"(none)\" : esc(q.choices[chosen]) + \" (\" + letter + \")\") + \"</strong></div>\" +\n477:         '<div class=\"ans-line\"><span class=\"ok\">Correct answer: ' + LETTERS[q.correctAnswer] + \".</span> \" + esc(q.choices[q.correctAnswer]) + \"</div>\" +\n478:         '<div class=\"review-expl\"><strong>Explanation:</strong> ' + esc(q.explanation) + \"</div>\" +\n479:         \"</div>\"\n480:       );\n481:     });\n482:     view.innerHTML =\n483:       '<div class=\"view-panel\">' +\n484:       '<h2 class=\"panel-title\">Review &mdash; ' + esc(ch.title) + \"</h2>\" +\n485:       '<p class=\"panel-sub\">Score: ' + st.correct + \"/\" + ch.questions.length + \"</p>\" +\n486:       '<div class=\"next-row\" style=\"justify-content:flex-start\"><button class=\"btn\" id=\"back-results\">Back to results</button></div>' +\n487:       items.join(\"\") +\n488:       \"</div>\";\n489: \n490:     document.getElementById(\"back-results\").addEventListener(\"click\", function () {\n491:       switchTo(\"ch|\" + chId);\n492:     });\n493:   }\n494: \n495:   /* ---------------- overall exam ---------------- */\n496: \n497:   function renderOverall() {\n498:     if (!overall) {\n499:       overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n500:     }\n501:     if (overall.submitted) { renderOverallResults(); return; }\n502:     if (!overall.started) {\n503:       view.innerHTML =\n504:         '<div class=\"view-panel\">' +\n505:         '<h2 class=\"panel-title\">Overall Exam</h2>' +\n506:         '<p class=\"panel-sub\">Combines every chapter. Untimed, Google Forms-style. You can change answers until you submit.</p>' +\n507:         '<div class=\"card\"><p class=\"muted\">' + flat.length + \" questions across \" + bank.chapters.length + \" chapters.</p>\" +\n508:         '<button class=\"btn btn-primary\" id=\"start-overall\">Begin Overall Exam</button></div></div>';\n509:       document.getElementById(\"start-overall\").addEventListener(\"click\", function () {\n510:         overall.started = true;\n511:         renderNav();\n512:         renderOverall();\n513:         window.scrollTo(0, 0);\n514:       });\n515:       return;\n516:     }\n517: \n518:     let html = '<div class=\"view-panel\">';\n519:     html += \"<h2 class=\\\"panel-title\\\">Overall Exam</h2>\" +\n520:       '<p class=\"panel-sub\">Untimed &middot; Answer all questions, then press submit. No time limit.</p>';\n521: \n522:     flat.forEach(function (item, idx) {\n523:       const q = item.q;\n524:       const chosen = overall.selected[q.id];\n525:       html += '<div class=\"overall-q\">' +\n526:         '<div class=\"oq-head\"><span class=\"oq-num\">' + (idx + 1) + '. ' + esc(q.question) + \"</span>\" +\n527:         '<span class=\"oq-chapter\">' + esc(item.ch.title) + \"</span></div>\" +\n528:         \"<fieldset>\";\n529:       q.choices.forEach(function (c, ci) {\n530:         const letter = LETTERS[ci];\n531:         html += '<label class=\"opt\"><input type=\"radio\" name=\"oq-' + esc(q.id) + '\" value=\"' + ci + '\"' +\n532:           (chosen === ci ? \" checked\" : \"\") + \">\" +\n533:           '<span class=\"opt-letter\">' + letter + \".</span> \" +\n534:           '<span class=\"opt-text\">' + esc(c) + \"</span></label>\";\n535:       });\n536:       html += \"</fieldset></div>\";\n537:     });\n538: \n539:     html += '<div class=\"next-row\"><button class=\"btn btn-primary\" id=\"submit-overall\">Submit Overall Exam</button>' +\n540:       '<button class=\"btn\" id=\"reset-overall\">Reset</button></div></div>';\n541: \n542:     view.innerHTML = html;\n543: \n544:     view.querySelectorAll('input[type=\"radio\"]').forEach(function (inp) {\n545:       inp.addEventListener(\"change\", function () {\n546:         overall.selected[inp.name.replace(\"oq-\", \"\")] = parseInt(inp.value, 10);\n547:       });\n548:     });\n549: \n550:     document.getElementById(\"submit-overall\").addEventListener(\"click\", function () {\n551:       if (confirm(\"Submit the Overall Exam? You cannot change answers afterward.\")) {\n552:         submitOverall();\n553:       }\n554:     });\n555:     document.getElementById(\"reset-overall\").addEventListener(\"click\", function () {\n556:       overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n557:       renderNav();\n558:       renderOverall();\n559:     });\n560:   }\n561: \n562:   function submitOverall() {\n563:     let correct = 0;\n564:     flat.forEach(function (item) {\n565:       const q = item.q;\n566:       const sel = overall.selected[q.id];\n567:       if (sel != null && sel === q.correctAnswer) correct += 1;\n568:     });\n569:     overall.submitted = true;\n570:     overall.correct = correct;\n571:     overall.incorrect = flat.length - correct;\n572:     overall.score = correct;\n573:     renderNav();\n574:     renderOverallResults();\n575:   }\n576: \n577:   function renderOverallResults() {\n578:     const total = flat.length;\n579:     const pct = total ? Math.round((overall.correct / total) * 100) : 0;\n580:     let html = '<div class=\"view-panel\">' +\n581:       \"<h2 class=\\\"panel-title\\\">Overall Exam Results</h2>\" +\n582:       '<div class=\"card\">' +\n583:       '<div class=\"result-big\">' + pct + \"%</div>\" +\n584:       '<div class=\"result-grid\">' +\n585:       '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--green)\">' + overall.correct + \"</span><span class=\\\"rc-label\\\">Correct</span></div>\" +\n586:       '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--red)\">' + overall.incorrect + \"</span><span class=\\\"rc-label\\\">Incorrect</span></div>\" +\n587:       '<div class=\"result-cell\"><span class=\"rc-value\">' + overall.correct + \"/\" + total + \"</span><span class=\\\"rc-label\\\">Score</span></div>\" +\n588:       \"</div>\" +\n589:       '<div class=\"result-actions\"><button class=\"btn\" id=\"retake-overall\">Retake</button></div>' +\n590:       \"</div>\";\n591: \n592:     flat.forEach(function (item, idx) {\n593:       const q = item.q;\n594:       const sel = overall.selected[q.id];\n595:       const ok = sel === q.correctAnswer;\n596:       html += '<div class=\"overall-q submitted\">' +\n597:         '<div class=\"oq-head\"><span class=\"oq-num\">' + (idx + 1) + '. ' + esc(q.question) + \"</span>\" +\n598:         '<span class=\"oq-chapter\">' + esc(item.ch.title) + \"</span></div>\";\n599:       q.choices.forEach(function (c, ci) {\n600:         let cls = \"opt\";\n601:         if (ci === q.correctAnswer) cls += \" good\";\n602:         else if (sel === ci) cls += \" bad cho\";\n603:         html += '<div class=\"' + cls + '\"><span class=\"opt-letter\">' + LETTERS[ci] + '.</span> ' +\n604:           '<span class=\"opt-text\">' + esc(c) + \"</span></div>\";\n605:       });\n606:       html += '<div class=\"oq-result\" style=\"color:' + (ok ? \"var(--green)\" : \"var(--red)\") + '\">' +\n607:         (ok ? \"Correct\" : sel == null ? \"Not answered\" : \"Incorrect\") + \"</div>\" +\n608:         '<div class=\"review-expl\"><strong>Explanation:</strong> ' + esc(q.explanation) + \"</div>\" +\n609:         \"</div>\";\n610:     });\n611:     html += \"</div>\";\n612: \n613:     view.innerHTML = html;\n614: \n615:     document.getElementById(\"retake-overall\").addEventListener(\"click\", function () {\n616:       overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n617:       renderNav();\n618:       renderOverall();\n619:     });\n620:   }\n621: \n622:   /* ---------------- answer key ---------------- */\n623: \n624:   function renderAnswerKey() {\n625:     let html = '<div class=\"view-panel\"><h2 class=\"panel-title\">Answer Key</h2>' +\n626:       '<p class=\"panel-sub\">Correct answer for every question.</p>';\n627: \n628:     bank.chapters.forEach(function (ch) {\n629:       html += '<div class=\"key-chapter\"><h3>' + esc(ch.title) + \"</h3><ol class=\\\"key-list\\\">\";\n630:       ch.questions.forEach(function (q) {\n631:         html += \"<li><span class=\\\"key-letter\\\">\" + LETTERS[q.correctAnswer] + \"</span> \" +\n632:           esc(q.choices[q.correctAnswer]) + \"</li>\";\n633:       });\n634:       html += \"</ol></div>\";\n635:     });\n636:     html += \"</div>\";\n637:     view.innerHTML = html;\n638:   }\n639: \n640:   /* ---------------- encyclopedia ---------------- */\n641: \n642:   function renderEncyclopedia() {\n643:     let html = '<div class=\"view-panel\"><h2 class=\"panel-title\">Encyclopedia</h2>' +\n644:       '<p class=\"panel-sub\">Key terms from the reference material.</p>';\n645: \n646:     if (!bank.encyclopedia || !bank.encyclopedia.length) {\n647:       html += '<p class=\"empty-note\">No encyclopedia entries were generated.</p></div>';\n648:       view.innerHTML = html;\n649:       return;\n650:     }\n651: \n652:     const byChapter = {};\n653:     bank.encyclopedia.forEach(function (e) {\n654:       const key = e.chapterId || \"general\";\n655:       (byChapter[key] = byChapter[key] || []).push(e);\n656:     });\n657: \n658:     Object.keys(byChapter).forEach(function (key) {\n659:       const ch = chapterById(key);\n660:       const label = ch ? ch.title : \"General\";\n661:       html += '<div class=\"enc-section\"><h3>' + esc(label) + \"</h3>\";\n662:       byChapter[key].forEach(function (e) {\n663:         html += '<div class=\"enc-term\"><strong>' + esc(e.term) + \"</strong> \" +\n664:           \"<span class=\\\"enc-def\\\">&mdash; \" + esc(e.definition) + \"</span></div>\";\n665:       });\n666:       html += \"</div>\";\n667:     });\n668:     html += \"</div>\";\n669:     view.innerHTML = html;\n670:   }\n671: \n672:   /* ---------------- home ---------------- */\n673: \n674:   function renderHome() {\n675:     view.innerHTML =\n676:       '<div class=\"view-panel\"><div class=\"card\"><h2 class=\"panel-title\">' + esc(bank.title) + \"</h2>\" +\n677:       \"<p class=\\\"muted\\\">Pick a chapter above to begin, or take the Overall Exam.</p></div></div>\";\n678:   }\n679: \n680:   /* ---------------- init ---------------- */\n681: \n682:   load();\n683: })();\n\n(End of file - total 683 lines)\n</content>","metadata":{"preview":"(function () {\n  \"use strict\";\n\n  const examId = document.body.dataset.examId;\n  const view = document.getElementById(\"view\");\n  const navEl = document.getElementById(\"exam-nav\");\n\n  let bank = null;\n  let flat = []; // [{ch, q}]\n  let currentView = null; // 'ch|ch1' | 'overall' | 'answerkey' | 'encyclopedia'\n\n  const LETTERS = [\"A\", \"B\", \"C\", \"D\"];\n\n  // chapterState[ch.chapterId] = {mode, started, completed, order[], index, score, correct, incorrect, answers{}, choiceOrder{}, timer}\n  const chapterState = {};\n  let overall = null; // {started, submitted, selected{}, score, correct, incorrect}\n\n  /* ---------------- helpers ---------------- */\n\n  function shuffle(arr) {","truncated":false,"loaded":[],"display":{"type":"file","path":"C:\\xampp\\htdocs\\automation\\side-project\\assets\\exam-app.js","text":"(function () {\n  \"use strict\";\n\n  const examId = document.body.dataset.examId;\n  const view = document.getElementById(\"view\");\n  const navEl = document.getElementById(\"exam-nav\");\n\n  let bank = null;\n  let flat = []; // [{ch, q}]\n  let currentView = null; // 'ch|ch1' | 'overall' | 'answerkey' | 'encyclopedia'\n\n  const LETTERS = [\"A\", \"B\", \"C\", \"D\"];\n\n  // chapterState[ch.chapterId] = {mode, started, completed, order[], index, score, correct, incorrect, answers{}, choiceOrder{}, timer}\n  const chapterState = {};\n  let overall = null; // {started, submitted, selected{}, score, correct, incorrect}\n\n  /* ---------------- helpers ---------------- */\n\n  function shuffle(arr) {\n    const a = arr.slice();\n    for (let i = a.length - 1; i > 0; i--) {\n      const j = Math.floor(Math.random() * (i + 1));\n      [a[i], a[j]] = [a[j], a[i]];\n    }\n    return a;\n  }\n\n  function esc(s) {\n    return String(s == null ? \"\" : s)\n      .replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\")\n      .replace(/\"/g, \"&quot;\");\n  }\n\n  function toast(msg) {\n    const t = document.createElement(\"div\");\n    t.className = \"toast\";\n    t.textContent = msg;\n    document.body.appendChild(t);\n    setTimeout(function () { t.remove(); }, 2600);\n  }\n\n  function activeLock() {\n    if (overall && overall.started && !overall.submitted) return \"overall\";\n    for (const ch of bank.chapters) {\n      const s = chapterState[ch.chapterId];\n      if (s && s.started && !s.completed) return ch.chapterId;\n    }\n    return null;\n  }\n\n  function chapterById(id) {\n    return bank.chapters.find(function (c) { return c.chapterId === id; }) || null;\n  }\n\n  /* ---------------- data loading ---------------- */\n\n  function load() {\n    fetch(\"api/data.php?id=\" + encodeURIComponent(examId))\n      .then(function (r) {\n        if (!r.ok) throw new Error(\"HTTP \" + r.status);\n        return r.json();\n      })\n      .then(function (data) {\n        if (!data || !Array.isArray(data.chapters) || !data.chapters.length) {\n          throw new Error(\"Question bank is empty or malformed\");\n        }\n        bank = data;\n        flat = [];\n        data.chapters.forEach(function (ch) {\n          ch.questions.forEach(function (q) { flat.push({ ch: ch, q: q }); });\n        });\n        document.title = data.title || document.title;\n        renderHeader();\n        renderNav();\n        switchTo(\"ch|\" + data.chapters[0].chapterId);\n      })\n      .catch(function (err) {\n        view.innerHTML = '<div class=\"view-panel\"><div class=\"panel-title\">Failed to load exam</div>' +\n          '<p class=\"muted\">' + esc(err.message) + '</p></div>';\n      });\n  }\n\n  function renderHeader() {\n    document.getElementById(\"exam-title\").textContent = bank.title || \"Exam\";\n    const meta = [];\n    if (bank.subject) meta.push(bank.subject);\n    meta.push(bank.chapters.length + \" chapters\");\n    meta.push(flat.length + \" questions\");\n    if (bank.summary) meta.push(bank.summary);\n    document.getElementById(\"exam-meta\").innerHTML = meta.map(function (m) {\n      return \"<span>\" + esc(m) + \"</span>\";\n    }).join(\" &middot; \");\n  }\n\n  /* ---------------- navigation ---------------- */\n\n  function renderNav() {\n    const lock = activeLock();\n    navEl.innerHTML = \"\";\n    navEl.appendChild(inlineContainer());\n\n    bank.chapters.forEach(function (ch) {\n      const s = chapterState[ch.chapterId];\n      const done = s && s.completed;\n      const btn = makeTab(\n        ch.title,\n        \"ch|\" + ch.chapterId,\n        done ? '<span class=\"chk\" aria-hidden=\"true\">\\u2713</span>' : \"\",\n        lock && lock !== ch.chapterId,\n        lock === ch.chapterId && !done\n      );\n      navEl.appendChild(btn);\n    });\n\n    navEl.appendChild(makeTab(\"Overall Exam\", \"overall\", overall && overall.submitted ? '<span class=\"chk\">\\u2713</span>' : \"\", lock === \"overall\" || (lock && lock !== \"overall\"), false));\n    navEl.appendChild(makeTab(\"Answer Key\", \"answerkey\", \"\", lock !== null, false));\n    navEl.appendChild(makeTab(\"Encyclopedia\", \"encyclopedia\", \"\", lock !== null, false));\n  }\n\n  function inlineContainer() {\n    const c = document.createElement(\"div\");\n    c.className = \"container\";\n    return c;\n  }\n\n  function makeTab(label, viewKey, suffix, locked, active) {\n    const b = document.createElement(\"button\");\n    b.className = \"nav-tab\";\n    if (active) b.classList.add(\"active\");\n    b.innerHTML = esc(label) + \" \" + (suffix || \"\");\n    if (locked) {\n      b.disabled = true;\n    } else {\n      b.addEventListener(\"click\", function () { switchTo(viewKey); });\n    }\n    return b;\n  }\n\n  function switchTo(key) {\n    const lock = activeLock();\n    if (lock && lock !== \"overall\" && key !== \"ch|\" + lock) {\n      const ch = chapterById(lock);\n      toast(\"Finish or reset \\u201c\" + (ch ? ch.title : lock) + \"\\u201d first to switch sections.\");\n      renderNav(); // re-affirm lock state\n      return;\n    }\n    if (lock === \"overall\" && key !== \"overall\") {\n      toast(\"Finish or submit the Overall Exam first to switch sections.\");\n      renderNav();\n      return;\n    }\n    currentView = key;\n    renderNav();\n    if (key === \"overall\") renderOverall();\n    else if (key === \"answerkey\") renderAnswerKey();\n    else if (key === \"encyclopedia\") renderEncyclopedia();\n    else if (key.indexOf(\"ch|\") === 0) renderChapter(key.slice(3));\n    else renderHome();\n  }\n\n  /* ---------------- chapter render ---------------- */\n\n  function freshChapterState(chId) {\n    const ch = chapterById(chId);\n    const order = shuffle(ch.questions.map(function (q) { return q.id; }));\n    const choiceOrder = {};\n    ch.questions.forEach(function (q) {\n      choiceOrder[q.id] = shuffle([0, 1, 2, 3]);\n    });\n    chapterState[chId] = {\n      mode: null,\n      started: false,\n      completed: false,\n      order: order,\n      index: 0,\n      score: 0,\n      correct: 0,\n      incorrect: 0,\n      answers: {},\n      choiceOrder: choiceOrder,\n      timer: null,\n    };\n  }\n\n  function getChapterState(chId) {\n    if (!chapterState[chId]) freshChapterState(chId);\n    return chapterState[chId];\n  }\n\n  function clearTimer(st) {\n    if (st.timer) {\n      clearInterval(st.timer);\n      st.timer = null;\n    }\n  }\n\n  function renderChapter(chId) {\n    const ch = chapterById(chId);\n    const st = getChapterState(chId);\n\n    if (st.completed) {\n      renderChapterResults(chId);\n      return;\n    }\n    if (!st.started || !st.mode) {\n      renderModeSelect(ch);\n      return;\n    }\n    renderQuestion(ch);\n  }\n\n  function renderModeSelect(ch) {\n    const st = getChapterState(ch.chapterId);\n    view.innerHTML =\n      '<div class=\"view-panel\">' +\n      '<h2 class=\"panel-title\">' + esc(ch.title) + '</h2>' +\n      '<p class=\"panel-sub\">' + esc(ch.description || \"\") + \"</p>\" +\n      '<div class=\"card start-card\">' +\n      '<p class=\"muted\">' + ch.questions.length + \" questions</p>\" +\n      '<p style=\"margin:0 0 4px;font-size:14px;\"><strong>Choose your mode</strong></p>' +\n      '<div class=\"mode-grid\">' +\n      '<div class=\"mode-option ' + (st.mode === \"timed\" ? \"selected\" : \"\") + '\" data-mode=\"timed\" role=\"button\" tabindex=\"0\" aria-pressed=\"' + (st.mode === \"timed\") + '\">' +\n      \"<h4>Timed</h4><p>10 seconds per question. Timeout counts as incorrect.</p></div>\" +\n      '<div class=\"mode-option ' + (st.mode === \"untimed\" ? \"selected\" : \"\") + '\" data-mode=\"untimed\" role=\"button\" tabindex=\"0\" aria-pressed=\"' + (st.mode === \"untimed\") + '\">' +\n      \"<h4>Untimed</h4><p>No time limit at all.</p></div>\" +\n      \"</div>\" +\n      '<button class=\"btn btn-primary\" id=\"start-id\">Start Chapter</button>' +\n      '<button class=\"btn\" id=\"shuffle-again\" style=\"margin-left:10px;\">Shuffle Questions</button>' +\n      \"</div></div>\";\n\n    view.querySelectorAll(\".mode-option\").forEach(function (el) {\n      const pick = function () {\n        st.mode = el.dataset.mode;\n        view.querySelectorAll(\".mode-option\").forEach(function (o) {\n          o.classList.toggle(\"selected\", o === el);\n          o.setAttribute(\"aria-pressed\", o === el ? \"true\" : \"false\");\n        });\n      };\n      el.addEventListener(\"click\", pick);\n      el.addEventListener(\"keydown\", function (e) {\n        if (e.key === \"Enter\" || e.key === \" \") { e.preventDefault(); pick(); }\n      });\n    });\n\n    document.getElementById(\"shuffle-again\").addEventListener(\"click\", function () {\n      freshChapterState(ch.chapterId);\n      renderModeSelect(ch);\n    });\n\n    document.getElementById(\"start-id\").addEventListener(\"click\", function () {\n      if (!st.mode) {\n        toast(\"Choose Timed or Untimed first.\");\n        return;\n      }\n      st.started = true;\n      st.index = 0;\n      renderNav();\n      renderChapter(ch.chapterId);\n    });\n  }\n\n  function currentQ(ch, st, displayIndex) {\n    const qid = st.order[displayIndex];\n    const q = ch.questions.find(function (x) { return x.id === qid; });\n    return q;\n  }\n\n  function renderQuestion(ch) {\n    const st = getChapterState(ch.chapterId);\n    const pos = st.index;\n    const q = currentQ(ch, st, pos);\n    if (!q) {\n      completeChapter(ch.chapterId);\n      return;\n    }\n\n    const total = ch.questions.length;\n    const displayNum = pos + 1;\n    const answered = st.answers[q.id];\n    const choiceOrder = st.choiceOrder[q.id];\n    const isTimed = st.mode === \"timed\";\n    const pct = Math.round((pos / total) * 100);\n\n    let html =\n      '<div class=\"view-panel\">' +\n      '<div class=\"q-header\">' +\n      '<div>' +\n      '<div class=\"q-progress-label\">' + esc(ch.title) + \" &middot; Question \" + displayNum + \" of \" + total + \" &middot; Progress: \" + pct + \"%</div>\" +\n      \"</div>\" +\n      '<div class=\"q-header-right\">' +\n      (isTimed ? '<span class=\"timer\" data-timer>10</span>' : \"\") +\n      '<span class=\"q-score\">Score: ' + st.correct + \"/\" + st.answered + \"</span>\" +\n      \"</div></div>\" +\n      '<div class=\"q-progress\"><div style=\"width:' + pct + '%\"></div></div>' +\n      '<div class=\"q-card\">' +\n      '<p class=\"q-text\">' + esc(q.question) + \"</p>\";\n\n    html += '<ul class=\"choices\">';\n    for (let i = 0; i < 4; i++) {\n      const origIdx = choiceOrder[i];\n      const cls = [];\n      if (answered) {\n        if (origIdx === q.correctAnswer) cls.push(\"correct\");\n        if (answered.selected === origIdx && origIdx !== q.correctAnswer) cls.push(\"incorrect\");\n      }\n      html += '<li><button class=\"choice ' + cls.join(\" \") + '\" data-choice=\"' + i + '\"' + (answered ? \" disabled\" : \"\") + \">\" +\n        '<span class=\"letter\">' + LETTERS[i] + \"</span>\" +\n        '<span class=\"choice-text\">' + esc(q.choices[origIdx]) + \"</span></button></li>\";\n    }\n    html += \"</ul>\";\n\n    if (answered) {\n      let cls = \"correct\", title = \"Correct!\", expl = esc(q.explanation);\n      if (answered.timedOut) { cls = \"timeout\"; title = \"Time's up!\"; }\n      else if (!answered.correct) { cls = \"incorrect\"; title = \"Incorrect.\"; }\n      html += '<div class=\"feedback ' + cls + '\"><span class=\"fb-title\">' + title + \"</span>\" +\n        \"<strong>Correct answer: \" + LETTERS[choiceOrder.indexOf(q.correctAnswer)] + \".</strong> \" +\n        \"<span>\" + expl + \"</span></div>\";\n      if (answered.timedOut) {\n        html += \"<p style=\\\"color:var(--muted);font-size:13px;\\\">Out of time &mdash; counted as incorrect. Score: \" +\n          st.correct + \"/\" + (st.correct + st.incorrect) + \".</p>\";\n      }\n      html += '<div class=\"next-row\"><button class=\"btn btn-primary\" id=\"next-btn\">' +\n        (pos + 1 >= total ? \"Finish Chapter\" : \"Next Question\") + \"</button></div>\";\n    }\n\n    html += \"</div>\" +\n      '<div class=\"next-row\"><button class=\"reset-link\" id=\"reset-link\">Reset chapter (choose mode again)</button></div>' +\n      \"</div>\";\n\n    view.innerHTML = html;\n\n    if (!answered) {\n      const idxQid = q.id;\n      view.querySelectorAll(\".choice\").forEach(function (btn) {\n        btn.addEventListener(\"click\", function () {\n          const choiceIdx = parseInt(btn.dataset.choice, 10);\n          const origIdx = st.choiceOrder[idxQid][choiceIdx];\n          answerChapterCurrent(ch.chapterId, idxQid, origIdx, choiceIdx);\n        });\n      });\n    } else {\n      document.getElementById(\"next-btn\").addEventListener(\"click\", function () {\n        clearTimer(st);\n        st.index += 1;\n        renderChapter(ch.chapterId);\n      });\n    }\n\n    document.getElementById(\"reset-link\").addEventListener(\"click\", function () {\n      if (confirm(\"Reset this chapter? Your score and progress will be cleared, and you can pick a new mode.\")) {\n        resetChapter(ch.chapterId);\n      }\n    });\n\n    if (!answered && isTimed) {\n      startTimer(ch.chapterId, q.id);\n    }\n  }\n\n  function startTimer(chId, qid) {\n    const st = getChapterState(chId);\n    clearTimer(st);\n    let left = 10;\n    const el = view.querySelector(\"[data-timer]\");\n    if (el) { el.textContent = left; el.classList.remove(\"low\"); }\n\n    st.timer = setInterval(function () {\n      // guard: only tick if the locked chapter is still this one\n      if (activeLock() !== chId) {\n        clearInterval(st.timer);\n        st.timer = null;\n        return;\n      }\n      if (!st.answers[qid]) {\n        left -= 1;\n        if (el) {\n          el.textContent = Math.max(0, left);\n          el.classList.toggle(\"low\", left <= 3);\n        }\n        if (left <= 0) {\n          clearInterval(st.timer);\n          st.timer = null;\n          answerChapterTimeout(chId, qid);\n        }\n      }\n    }, 1000);\n  }\n\n  function answerChapterCurrent(chId, qid, origIdx, choiceIdx) {\n    const st = getChapterState(chId);\n    const q = chapterById(chId).questions.find(function (x) { return x.id === qid; });\n    const correct = origIdx === q.correctAnswer;\n    st.answers[qid] = { selected: origIdx, correct: correct, timedOut: false, at: choiceIdx };\n    st.answered = Object.keys(st.answers).length;\n    if (correct) { st.correct += 1; st.score += 1; } else { st.incorrect += 1; }\n    clearTimer(st);\n    renderChapter(chId);\n  }\n\n  function answerChapterTimeout(chId, qid) {\n    const st = getChapterState(chId);\n    if (st.answers[qid]) return; // already answered\n    st.answers[qid] = { selected: null, correct: false, timedOut: true, at: null };\n    st.answered = Object.keys(st.answers).length;\n    st.incorrect += 1;\n    renderChapter(chId);\n  }\n\n  function completeChapter(chId) {\n    const st = getChapterState(chId);\n    st.completed = true;\n    clearTimer(st);\n    renderNav();\n    renderChapterResults(chId);\n  }\n\n  function resetChapter(chId) {\n    const st = getChapterState(chId);\n    clearTimer(st);\n    freshChapterState(chId);\n    renderNav();\n    renderChapter(chId);\n  }\n\n  function renderChapterResults(chId) {\n    const ch = chapterById(chId);\n    const st = getChapterState(chId);\n    const total = ch.questions.length;\n    const pct = total ? Math.round((st.correct / total) * 100) : 0;\n\n    view.innerHTML =\n      '<div class=\"view-panel\">' +\n      '<h2 class=\"panel-title\">Chapter complete</h2>' +\n      '<p class=\"panel-sub\">' + esc(ch.title) + \"</p>\" +\n      '<div class=\"card\">' +\n      '<div class=\"result-big\">' + pct + \"%</div>\" +\n      '<div class=\"result-grid\">' +\n      '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--green)\">' + st.correct + \"</span><span class=\\\"rc-label\\\">Correct</span></div>\" +\n      '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--red)\">' + st.incorrect + \"</span><span class=\\\"rc-label\\\">Incorrect</span></div>\" +\n      '<div class=\"result-cell\"><span class=\"rc-value\">' + st.correct + \"/\" + total + \"</span><span class=\\\"rc-label\\\">Score</span></div>\" +\n      '<div class=\"result-cell\"><span class=\"rc-value\">' + (st.mode === \"timed\" ? \"Timed\" : \"Untimed\") + \"</span><span class=\\\"rc-label\\\">Mode</span></div>\" +\n      \"</div>\" +\n      '<div class=\"result-actions\">' +\n      '<button class=\"btn btn-primary\" id=\"review-btn\">Review Answers</button>' +\n      '<button class=\"btn\" id=\"retake-btn\">Retake (reset)</button>' +\n      '<button class=\"btn\" id=\"again-btn\">Shuffle &amp; Retake</button>' +\n      \"</div></div></div>\";\n\n    document.getElementById(\"review-btn\").addEventListener(\"click\", function () {\n      renderReview(chId);\n    });\n    document.getElementById(\"retake-btn\").addEventListener(\"click\", function () {\n      resetChapter(chId);\n    });\n    document.getElementById(\"again-btn\").addEventListener(\"click\", function () {\n      freshChapterState(chId);\n      renderModeSelect(ch);\n    });\n  }\n\n  function renderReview(chId) {\n    const ch = chapterById(chId);\n    const st = getChapterState(chId);\n    const items = ch.questions.map(function (q) {\n      const a = st.answers[q.id];\n      const chosen = a ? a.selected : null;\n      const ok = !!(a && a.correct);\n      const verdict = ok ? \"Correct\" : (a && a.timedOut ? \"Time's up (incorrect)\" : \"Incorrect\");\n      const letter = a && a.at != null ? LETTERS[a.at] : \"-\";\n      return (\n        '<div class=\"review-item\">' +\n        '<p class=\"rq\">' + esc(q.question) + \"</p>\" +\n        '<div class=\"ans-line\"><span class=\"' + (ok ? \"ok\" : \"no\") + '\">' + verdict + \"</span> &mdash; Your answer: <strong>\" +\n        (chosen == null ? \"(none)\" : esc(q.choices[chosen]) + \" (\" + letter + \")\") + \"</strong></div>\" +\n        '<div class=\"ans-line\"><span class=\"ok\">Correct answer: ' + LETTERS[q.correctAnswer] + \".</span> \" + esc(q.choices[q.correctAnswer]) + \"</div>\" +\n        '<div class=\"review-expl\"><strong>Explanation:</strong> ' + esc(q.explanation) + \"</div>\" +\n        \"</div>\"\n      );\n    });\n    view.innerHTML =\n      '<div class=\"view-panel\">' +\n      '<h2 class=\"panel-title\">Review &mdash; ' + esc(ch.title) + \"</h2>\" +\n      '<p class=\"panel-sub\">Score: ' + st.correct + \"/\" + ch.questions.length + \"</p>\" +\n      '<div class=\"next-row\" style=\"justify-content:flex-start\"><button class=\"btn\" id=\"back-results\">Back to results</button></div>' +\n      items.join(\"\") +\n      \"</div>\";\n\n    document.getElementById(\"back-results\").addEventListener(\"click\", function () {\n      switchTo(\"ch|\" + chId);\n    });\n  }\n\n  /* ---------------- overall exam ---------------- */\n\n  function renderOverall() {\n    if (!overall) {\n      overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n    }\n    if (overall.submitted) { renderOverallResults(); return; }\n    if (!overall.started) {\n      view.innerHTML =\n        '<div class=\"view-panel\">' +\n        '<h2 class=\"panel-title\">Overall Exam</h2>' +\n        '<p class=\"panel-sub\">Combines every chapter. Untimed, Google Forms-style. You can change answers until you submit.</p>' +\n        '<div class=\"card\"><p class=\"muted\">' + flat.length + \" questions across \" + bank.chapters.length + \" chapters.</p>\" +\n        '<button class=\"btn btn-primary\" id=\"start-overall\">Begin Overall Exam</button></div></div>';\n      document.getElementById(\"start-overall\").addEventListener(\"click\", function () {\n        overall.started = true;\n        renderNav();\n        renderOverall();\n        window.scrollTo(0, 0);\n      });\n      return;\n    }\n\n    let html = '<div class=\"view-panel\">';\n    html += \"<h2 class=\\\"panel-title\\\">Overall Exam</h2>\" +\n      '<p class=\"panel-sub\">Untimed &middot; Answer all questions, then press submit. No time limit.</p>';\n\n    flat.forEach(function (item, idx) {\n      const q = item.q;\n      const chosen = overall.selected[q.id];\n      html += '<div class=\"overall-q\">' +\n        '<div class=\"oq-head\"><span class=\"oq-num\">' + (idx + 1) + '. ' + esc(q.question) + \"</span>\" +\n        '<span class=\"oq-chapter\">' + esc(item.ch.title) + \"</span></div>\" +\n        \"<fieldset>\";\n      q.choices.forEach(function (c, ci) {\n        const letter = LETTERS[ci];\n        html += '<label class=\"opt\"><input type=\"radio\" name=\"oq-' + esc(q.id) + '\" value=\"' + ci + '\"' +\n          (chosen === ci ? \" checked\" : \"\") + \">\" +\n          '<span class=\"opt-letter\">' + letter + \".</span> \" +\n          '<span class=\"opt-text\">' + esc(c) + \"</span></label>\";\n      });\n      html += \"</fieldset></div>\";\n    });\n\n    html += '<div class=\"next-row\"><button class=\"btn btn-primary\" id=\"submit-overall\">Submit Overall Exam</button>' +\n      '<button class=\"btn\" id=\"reset-overall\">Reset</button></div></div>';\n\n    view.innerHTML = html;\n\n    view.querySelectorAll('input[type=\"radio\"]').forEach(function (inp) {\n      inp.addEventListener(\"change\", function () {\n        overall.selected[inp.name.replace(\"oq-\", \"\")] = parseInt(inp.value, 10);\n      });\n    });\n\n    document.getElementById(\"submit-overall\").addEventListener(\"click\", function () {\n      if (confirm(\"Submit the Overall Exam? You cannot change answers afterward.\")) {\n        submitOverall();\n      }\n    });\n    document.getElementById(\"reset-overall\").addEventListener(\"click\", function () {\n      overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n      renderNav();\n      renderOverall();\n    });\n  }\n\n  function submitOverall() {\n    let correct = 0;\n    flat.forEach(function (item) {\n      const q = item.q;\n      const sel = overall.selected[q.id];\n      if (sel != null && sel === q.correctAnswer) correct += 1;\n    });\n    overall.submitted = true;\n    overall.correct = correct;\n    overall.incorrect = flat.length - correct;\n    overall.score = correct;\n    renderNav();\n    renderOverallResults();\n  }\n\n  function renderOverallResults() {\n    const total = flat.length;\n    const pct = total ? Math.round((overall.correct / total) * 100) : 0;\n    let html = '<div class=\"view-panel\">' +\n      \"<h2 class=\\\"panel-title\\\">Overall Exam Results</h2>\" +\n      '<div class=\"card\">' +\n      '<div class=\"result-big\">' + pct + \"%</div>\" +\n      '<div class=\"result-grid\">' +\n      '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--green)\">' + overall.correct + \"</span><span class=\\\"rc-label\\\">Correct</span></div>\" +\n      '<div class=\"result-cell\"><span class=\"rc-value\" style=\"color:var(--red)\">' + overall.incorrect + \"</span><span class=\\\"rc-label\\\">Incorrect</span></div>\" +\n      '<div class=\"result-cell\"><span class=\"rc-value\">' + overall.correct + \"/\" + total + \"</span><span class=\\\"rc-label\\\">Score</span></div>\" +\n      \"</div>\" +\n      '<div class=\"result-actions\"><button class=\"btn\" id=\"retake-overall\">Retake</button></div>' +\n      \"</div>\";\n\n    flat.forEach(function (item, idx) {\n      const q = item.q;\n      const sel = overall.selected[q.id];\n      const ok = sel === q.correctAnswer;\n      html += '<div class=\"overall-q submitted\">' +\n        '<div class=\"oq-head\"><span class=\"oq-num\">' + (idx + 1) + '. ' + esc(q.question) + \"</span>\" +\n        '<span class=\"oq-chapter\">' + esc(item.ch.title) + \"</span></div>\";\n      q.choices.forEach(function (c, ci) {\n        let cls = \"opt\";\n        if (ci === q.correctAnswer) cls += \" good\";\n        else if (sel === ci) cls += \" bad cho\";\n        html += '<div class=\"' + cls + '\"><span class=\"opt-letter\">' + LETTERS[ci] + '.</span> ' +\n          '<span class=\"opt-text\">' + esc(c) + \"</span></div>\";\n      });\n      html += '<div class=\"oq-result\" style=\"color:' + (ok ? \"var(--green)\" : \"var(--red)\") + '\">' +\n        (ok ? \"Correct\" : sel == null ? \"Not answered\" : \"Incorrect\") + \"</div>\" +\n        '<div class=\"review-expl\"><strong>Explanation:</strong> ' + esc(q.explanation) + \"</div>\" +\n        \"</div>\";\n    });\n    html += \"</div>\";\n\n    view.innerHTML = html;\n\n    document.getElementById(\"retake-overall\").addEventListener(\"click\", function () {\n      overall = { started: false, submitted: false, selected: {}, score: 0, correct: 0, incorrect: 0 };\n      renderNav();\n      renderOverall();\n    });\n  }\n\n  /* ---------------- answer key ---------------- */\n\n  function renderAnswerKey() {\n    let html = '<div class=\"view-panel\"><h2 class=\"panel-title\">Answer Key</h2>' +\n      '<p class=\"panel-sub\">Correct answer for every question.</p>';\n\n    bank.chapters.forEach(function (ch) {\n      html += '<div class=\"key-chapter\"><h3>' + esc(ch.title) + \"</h3><ol class=\\\"key-list\\\">\";\n      ch.questions.forEach(function (q) {\n        html += \"<li><span class=\\\"key-letter\\\">\" + LETTERS[q.correctAnswer] + \"</span> \" +\n          esc(q.choices[q.correctAnswer]) + \"</li>\";\n      });\n      html += \"</ol></div>\";\n    });\n    html += \"</div>\";\n    view.innerHTML = html;\n  }\n\n  /* ---------------- encyclopedia ---------------- */\n\n  function renderEncyclopedia() {\n    let html = '<div class=\"view-panel\"><h2 class=\"panel-title\">Encyclopedia</h2>' +\n      '<p class=\"panel-sub\">Key terms from the reference material.</p>';\n\n    if (!bank.encyclopedia || !bank.encyclopedia.length) {\n      html += '<p class=\"empty-note\">No encyclopedia entries were generated.</p></div>';\n      view.innerHTML = html;\n      return;\n    }\n\n    const byChapter = {};\n    bank.encyclopedia.forEach(function (e) {\n      const key = e.chapterId || \"general\";\n      (byChapter[key] = byChapter[key] || []).push(e);\n    });\n\n    Object.keys(byChapter).forEach(function (key) {\n      const ch = chapterById(key);\n      const label = ch ? ch.title : \"General\";\n      html += '<div class=\"enc-section\"><h3>' + esc(label) + \"</h3>\";\n      byChapter[key].forEach(function (e) {\n        html += '<div class=\"enc-term\"><strong>' + esc(e.term) + \"</strong> \" +\n          \"<span class=\\\"enc-def\\\">&mdash; \" + esc(e.definition) + \"</span></div>\";\n      });\n      html += \"</div>\";\n    });\n    html += \"</div>\";\n    view.innerHTML = html;\n  }\n\n  /* ---------------- home ---------------- */\n\n  function renderHome() {\n    view.innerHTML =\n      '<div class=\"view-panel\"><div class=\"card\"><h2 class=\"panel-title\">' + esc(bank.title) + \"</h2>\" +\n      \"<p class=\\\"muted\\\">Pick a chapter above to begin, or take the Overall Exam.</p></div></div>\";\n  }\n\n  /* ---------------- init ---------------- */\n\n  load();\n})();","lineStart":1,"lineEnd":683,"totalLines":683,"truncated":false}},"title":"xampp\\htdocs\\automation\\side-project\\assets\\exam-app.js","time":{"start":1789817799457,"end":1789817799508}},"id":"prt_0b9744288001gczN0qCyJHBtD0","sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","messageID":"msg_0b974265a0013IDGcbEsLe7JYM"}}
