{"type":"tool_use","timestamp":1789818470170,"sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","part":{"type":"tool","tool":"write","callID":"call_d678f3848c6d40f1a630faf6","state":{"status":"completed","input":{"content":"import json, os, random, re, sys\n\nBUILD = r\"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\"\nTARGET = r\"C:\\xampp\\htdocs\\automation\\side-project\\data\\exams\\test001\\questions.json\"\n\ndef load(name):\n    with open(os.path.join(BUILD, name), \"r\", encoding=\"utf-8\") as f:\n        return json.load(f)\n\nmeta = load(\"meta.json\")\nchapters = []\nfor i in range(1, 8):\n    a = load(f\"ch{i}a.json\")\n    b = load(f\"ch{i}b.json\")\n    assert isinstance(a, dict) and \"chapterId\" in a, f\"ch{i}a malformed\"\n    assert isinstance(b, list) and b, f\"ch{i}b malformed\"\n    questions = list(a[\"questions\"]) + list(b)\n    chapters.append({\n        \"chapterId\": a[\"chapterId\"],\n        \"title\": a[\"title\"],\n        \"description\": a[\"description\"],\n        \"questions\": questions,\n    })\n\nenc = load(\"enc_part1.json\") + load(\"enc_part2.json\")\n\n# ---------- Validation pass ----------\nerrors = []\nfor ch in chapters:\n    ids = [q[\"id\"] for q in ch[\"questions\"]]\n    if len(ids) != len(set(ids)):\n        errors.append(f\"[{ch['chapterId']}] duplicate question ids\")\n    if len(ch[\"questions\"]) != 30:\n        errors.append(f\"[{ch['chapterId']}] count={len(ch['questions'])} != 30\")\n    counts = {\"A\":0,\"B\":0,\"C\":0,\"D\":0}\n    for q in ch[\"questions\"]:\n        for field in (\"id\",\"question\",\"choices\",\"correctAnswer\",\"explanation\"):\n            if field not in q or q[field] in (None, \"\", []):\n                errors.append(f\"[{ch['chapterId']}:{q.get('id')}] missing/empty {field}\")\n                continue\n        if len(q[\"choices\"]) != 4:\n            errors.append(f\"[{q['id']}] choices={len(q['choices'])} != 4\")\n        if not isinstance(q[\"correctAnswer\"], int) or not (0 <= q[\"correctAnswer\"] <= 3):\n            errors.append(f\"[{q['id']}] correctAnswer invalid\")\n        # unique choices\n        if len(set(q[\"choices\"])) != 4:\n            errors.append(f\"[{q['id']}] duplicate choices\")\n        counts[\"ABCD\"[q[\"correctAnswer\"]]] += 1\n    print(f\"[{ch['chapterId']}] pre-rebalance dist:\", counts)\n\nif errors:\n    print(\"VALIDATION ERRORS:\")\n    for e in errors:\n        print(\"  \" + e)\n    sys.exit(1)\n\n# ---------- Anti-guessing audit (before/after) ----------\ndef audit(ch, label):\n    bad = []\n    for q in ch[\"questions\"]:\n        lens = [len(c.strip()) for c in q[\"choices\"]]\n        lengths = set(lens)\n        if len(question := re.sub(r\"\\s+\", \" \", q[\"question\"]).strip()) < 15:\n            bad.append(f\"{q['id']}: question too short\")\n        if len(lens) and (max(lens) - min(lens)) > 60:\n            bad.append(f\"{q['id']}: choice lengths vary too much {lens}\")\n        # keyword leakage check: correct choice shares meaningful keyword with question\n        def words(s):\n            return {w for w in re.sub(r\"[^a-zA-Z0-9 ]\", \" \", s.lower()).split() if len(w) > 3}\n        qw = words(q[\"question\"])\n        correct = q[\"choices\"][q[\"correctAnswer\"]]\n        others = [c for i, c in enumerate(q[\"choices\"]) if i != q[\"correctAnswer\"]]\n        leak = words(correct) & qw\n        # crude heuristic: report it, not fail\n        if leak and not any(words(o) & qw for o in others):\n            bad.append(f\"{q['id']}: correct choice shares keywords with question ({sorted(leak)})\")\n    if bad:\n        print(f\"[{ch['chapterId']}] {label} anti-guessing notes:\")\n        for b in bad[:8]:\n            print(\"   \" + b)\n    else:\n        print(f\"[{ch['chapterId']}] {label} anti-guessing OK\")\n\nfor ch in chapters:\n    audit(ch, \"PRE\")\n\n# ---------- Rebalance answer distribution to ~8/8/7/7 ----------\nrandom.seed(20260919)\nfor ch in chapters:\n    dist = {\"A\":0,\"B\":0,\"C\":0,\"D\":0}\n    for q in ch[\"questions\"]:\n        dist[\"ABCD\"[q[\"correctAnswer\"]]] += 1\n    # build target queue of letters, 8/8/7/7, shuffled\n    letter_counts = {\"A\":8, \"B\":8, \"C\":7, \"D\":7}\n    pool = []\n    for letter, n in letter_counts.items():\n        pool += [letter] * n\n    random.shuffle(pool)\n    for q, target_letter in zip(ch[\"questions\"], pool):\n        cur = q[\"correctAnswer\"]\n        target = \"ABCD\".index(target_letter)\n        k = (cur - target) % 4  # rotate left by k to move answer to target index\n        if k:\n            q[\"choices\"] = q[\"choices\"][k:] + q[\"choices\"][:k]\n            q[\"correctAnswer\"] = target\n    counts = {\"A\":0,\"B\":0,\"C\":0,\"D\":0}\n    for q in ch[\"questions\"]:\n        counts[\"ABCD\"[q[\"correctAnswer\"]]] += 1\n    print(f\"[{ch['chapterId']}] POST-rebalance dist:\", counts)\n\nfor ch in chapters:\n    audit(ch, \"POST\")\n\n# ---------- Assemble ----------\nout = {\n    \"title\": meta[\"title\"],\n    \"subject\": meta[\"subject\"],\n    \"summary\": meta[\"summary\"],\n    \"chapters\": chapters,\n    \"encyclopedia\": enc,\n}\n\n# ---------- Final validation ----------\nfe = []\nseen_enc = set()\nfor e in enc:\n    if (e[\"chapterId\"], e[\"term\"]) in seen_enc:\n        fe.append(f\"duplicate encyclopedia {e['chapterId']}:{e['term']}\")\n    seen_enc.add((e[\"chapterId\"], e[\"term\"]))\n    if not e.get(\"definition\"):\n        fe.append(f\"empty definition: {e['term']}\")\n    if e[\"chapterId\"] not in [c[\"chapterId\"] for c in chapters]:\n        fe.append(f\"encyclopedia chapter not found: {e['chapterId']}\")\ntotal_q = sum(len(c[\"questions\"]) for c in chapters)\nprint(f\"total questions: {total_q}, encyclopedia entries: {len(enc)}\")\nfor c in chapters:\n    if not c[\"title\"] or not c[\"description\"]:\n        fe.append(f\"[{c['chapterId']}] missing title/description\")\nif fe:\n    print(\"FINAL ERRORS:\")\n    for e in fe:\n        print(\"  \" + e)\n    sys.exit(1)\n\n# verify serialization round-trip\nwith open(TARGET, \"w\", encoding=\"utf-8\") as f:\n    json.dump(out, f, ensure_ascii=False, indent=2)\nwith open(TARGET, \"r\", encoding=\"utf-8\") as f:\n    json.load(f)\nprint(\"WROTE\", TARGET)\nprint(\"OK\")","filePath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\merge.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\merge.py","exists":false,"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\sai_build\\merge.py","time":{"start":1789818470157,"end":1789818470166}},"id":"prt_0b97e43b3001F3c2ivagDg2klN","sessionID":"ses_f468c1d68ffe9hPjm84tFHrrnQ","messageID":"msg_0b97e1e2e001sBywb3yLsGlzMb"}}
