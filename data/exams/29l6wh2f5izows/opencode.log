COMMAND: "C:/Users/kelly/AppData/Roaming/npm/node_modules/opencode-ai/bin/opencode.exe" run --format json --auto --dir "C:/xampp/htdocs/automation/side-project" --file "C:/xampp/htdocs/automation/side-project/data/exams/29l6wh2f5izows/source.txt" --title "system-add exam" "You are generating an interactive comprehensive exam system for a web app.

