{"type":"tool_use","timestamp":1789885551886,"sessionID":"ses_f428a512fffed89OwSRaaEXqP0","part":{"type":"tool","tool":"write","callID":"call_2eb15daa72244e0aa1548c7d","state":{"status":"completed","input":{"content":"<?php\n$file = $argv[1];\n$data = json_decode(file_get_contents($file), true);\nif (!is_array($data)) { fwrite(STDERR, \"INVALID JSON\\n\"); exit(1); }\n\n// target per-chapter distributions (sums to question count)\n$targets = [\n    'ch1' => [8,7,8,7],\n    'ch2' => [8,7,7,8],\n    'ch3' => [5,5,5,5],\n    'ch4' => [7,8,7,8],\n    'ch5' => [7,8,7,8],\n];\n\n$totalGoal = [0,0,0,0];\nforeach ($targets as $t) for ($i=0;$i<4;$i++) $totalGoal[$i] += $t[$i];\n\nforeach ($data['chapters'] as $ci => &$ch) {\n    $tt = $targets[$ch['chapterId']] ?? [7,7,8,8];\n    // build multiset of target letters\n    $letters = [];\n    foreach ($tt as $i => $n) for ($k=0;$k<$n;$k++) $letters[] = $i;\n    // Fisher-Yates shuffle\n    for ($i = count($letters)-1; $i > 0; $i--) {\n        $j = random_int(0, $i);\n        [$letters[$i], $letters[$j]] = [$letters[$j], $letters[$i]];\n    }\n    foreach ($ch['questions'] as $qi => &$q) {\n        $from = $q['correctAnswer'];\n        $to = $letters[$qi % count($letters)];\n        $arr = array_values($q['choices']);\n        $val = array_splice($arr, $from, 1);\n        array_splice($arr, $to, 0, $val);\n        $q['choices'] = array_values($arr);\n        $q['correctAnswer'] = $to;\n    }\n    unset($q);\n}\nunset($ch);\n\nfile_put_contents($file, json_encode($data, JSON_PRETTY_PRINT | JSON_UNESCAPED_UNICODE));\necho \"REBALANCED. Goal totals: \" . json_encode($totalGoal) . \"\\n\";","filePath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\rebalance.php"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\rebalance.php","exists":false,"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\rebalance.php","time":{"start":1789885551870,"end":1789885551884}},"id":"prt_0bd7e07a4001nGNGY7PkOlUZdn","sessionID":"ses_f428a512fffed89OwSRaaEXqP0","messageID":"msg_0bd7da57c001EIFvjLBZMRZ91H"}}
