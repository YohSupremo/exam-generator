ons":96,"deletions":0},"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\ch6.json","time":{"start":1789887781398,"end":1789887781416}},"id":"prt_0bd9ff5d50017qd7CTlf3YOLEG","sessionID":"ses_f42685812ffeYBxHvYBLR3HFUo","messageID":"msg_0bd9fcc3d001kquDqzbzgKS60p"}}
