{"type":"tool_use","timestamp":1789888178864,"sessionID":"ses_f42685812ffeYBxHvYBLR3HFUo","part":{"type":"tool","tool":"write","callID":"call_15fdbaf618f847da90375ed2","state":{"status":"completed","input":{"content":"import json, sys, collections, os\n\nBASE = r\"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\"\nOUT = r\"C:\\xampp\\htdocs\\automation\\side-project\\data\\exams\\pwso6i7z2c08kk\\questions.json\"\n\nerrors = []\ndef err(msg):\n    errors.append(msg)\n\nmeta = json.load(open(os.path.join(BASE, \"meta.json\"), encoding=\"utf-8\"))\nchapters = []\nqids = set()\nenc = list(meta.get(\"encyclopedia\", []))\nchapter_ids = set()\n\nfor i in range(1, 9):\n    p = os.path.join(BASE, f\"ch{i}.json\")\n    ch = json.load(open(p, encoding=\"utf-8\"))\n    qlist = ch[\"questions\"]\n    if not 10 <= len(qlist) <= 40:\n        err(f\"ch{i}: odd question count {len(qlist)}\")\n    ch[\"questions\"] = qlist\n    chapters.append(ch)\n    chapter_ids.add(ch[\"chapterId\"])\n\nfor fname in (\"enc234.json\", \"enc58.json\"):\n    enc += json.load(open(os.path.join(BASE, fname), encoding=\"utf-8\"))\n\n# ---- validation ----\nfor ch in chapters:\n    cid = ch[\"chapterId\"]\n    letters = collections.Counter()\n    for j, q in enumerate(ch[\"questions\"]):\n        qid = q.get(\"id\")\n        if not qid or qid in qids:\n            err(f\"{cid}: duplicate/missing id {qid!r}\")\n        qids.add(qid)\n        if len(q.get(\"choices\", [])) != 4:\n            err(f\"{qid}: choices != 4\")\n        if not isinstance(q.get(\"correctAnswer\"), int) or not 0 <= q[\"correctAnswer\"] <= 3:\n            err(f\"{qid}: correctAnswer invalid\")\n        if not q.get(\"explanation\", \"\").strip():\n            err(f\"{qid}: missing explanation\")\n        qtext = q.get(\"question\", \"\")\n        if not qtext.strip():\n            err(f\"{qid}: empty question\")\n        if any(not c.strip() for c in q[\"choices\"]):\n            err(f\"{qid}: empty choice\")\n        if q[\"correctAnswer\"] in (0, 1, 2, 3):\n            letters[\"ABCD\"[q[\"correctAnswer\"]]] += 1\n        # ensure correct choice duplicates no other choice text (sanity)\n        c = q[\"choices\"][q[\"correctAnswer\"]]\n        if sum(1 for x in q[\"choices\"] if x == c) > 1:\n            err(f\"{qid}: duplicate choice text (correct one)\")\n    mx, mn = max(letters.values()), min(letters.values())\n    if mx - mn > 1:\n        err(f\"{cid}: letter imbalance {dict(letters)}\")\n    print(f\"{cid}: {len(ch['questions'])}qs {dict(letters)}\")\n\nenc_ids = [q[\"chapterId\"] for q in enc]\nif any(c not in chapter_ids for c in set(enc_ids)):\n    err(\"encyclopedia references unknown chapter\")\nper = collections.Counter(enc_ids)\nfor c in sorted(chapter_ids):\n    if per[c] < 10:\n        err(f\"{c}: only {per[c]} encyclopedia entries (<10)\")\n\n# ---- build ----\ndata = {\n    \"title\": meta[\"title\"],\n    \"subject\": meta[\"subject\"],\n    \"summary\": meta[\"summary\"],\n    \"chapters\": chapters,\n    \"encyclopedia\": enc,\n}\n\ntotal = sum(len(c[\"questions\"]) for c in chapters)\nprint(f\"TOTAL QUESTIONS: {total}, encyclopedia entries: {len(enc)}\")\n\nif errors:\n    print(\"VALIDATION FAILED\")\n    for e in errors:\n        print(\" -\", e)\n    sys.exit(1)\n\nwith open(OUT, \"w\", encoding=\"utf-8\") as f:\n    json.dump(data, f, ensure_ascii=False, indent=2)\nprint(f\"WROTE {OUT} ({os.path.getsize(OUT)} bytes)\")","filePath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\merge.py"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\merge.py","exists":false,"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\merge.py","time":{"start":1789888178856,"end":1789888178862}},"id":"prt_0bda60c520013Pkc9CLPYvSUZM","sessionID":"ses_f42685812ffeYBxHvYBLR3HFUo","messageID":"msg_0bda603a800113uWkUX4W0FRDn"}}
