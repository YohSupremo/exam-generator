{"type":"tool_use","timestamp":1789888110774,"sessionID":"ses_f42685812ffeYBxHvYBLR3HFUo","part":{"type":"tool","tool":"write","callID":"call_2a5ce05da21b499ab86886c7","state":{"status":"completed","input":{"content":"[\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Mapanuring Pagbasa\",\n    \"definition\": \"Uri ng pagbasa na may tatlong bahagi: bago bumasa (pre-reading), habang nagbabasa (during reading), at pagkatapos magbasa (post-reading).\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Previewing o Surveying\",\n    \"definition\": \"Mabilisang pagtingin sa mga larawan, pamagat, at pangalawang pamagat sa loob ng aklat; kabilang sa yugtong bago bumasa upang malaman ang tamang estratehiya batay sa genre.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Pagtantiya sa Bilis ng Pagbasa\",\n    \"definition\": \"Kasanayan habang nagbabasa na kinapapalooban ng pagbabago-bago ng bilis o bagal ng pagbasa batay sa hirap ng teksto at personal na kakayahan.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Biswalisasyon ng Binabasa\",\n    \"definition\": \"Pagbubuo ng mga imahen sa isip habang nagbabasa gamit ang impormasyon mula sa teksto at imbak na kaalaman.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Pagbuo ng Koneksiyon\",\n    \"definition\": \"Pagpapayaman ng ugnayan sa pagitan ng teksto at imbak na kaalaman upang matiyak ang komprehensiyon.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Paghihinuha\",\n    \"definition\": \"Pag-uugnay ng impormasyon mula sa teksto at ng imbak na kaalaman upang bumuo ng mga pahiwatig at konklusyon.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Pagsubaybay sa Komprehensiyon\",\n    \"definition\": \"Pagtukoy sa posibleng kahirapan sa pagbasa at paggawa ng hakbang upang ito ay malutas.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Muling Pagbasa\",\n    \"definition\": \"Pagbabalik-basa sa isang bahagi o kabuuan ng teksto kung hindi ito naunawaan.\"\n  },\n  {\n    \"chapterId\": \"ch2\",\n    \"term\": \"Pagkuha ng Kahulugan mula sa Konteksto\",\n    \"definition\": \"Paggamit ng iba't ibang estratehiya upang alamin ang kahulugan ng di-pamilyar na salita batay sa ibang impormasyon sa teksto.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Tekstong Impormatibo\",\n    \"definition\": \"Uri ng babasahing di-piksyon na naglalayong maibigay ang impormasyon o magpaliwanag nang malinaw at walang pagkiling; sinasagot ang ano, sino, kailan, saan, at paano.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Sanhi at Bunga\",\n    \"definition\": \"Paraan ng paglalahad kung saan ang sanhi ay ang pinagmulan o dahilan ng pangyayari at ang bunga ay ang resulta o epekto nito; hudyat: dahil, kung kaya, kasi, sapagkat, kung, kapag.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Paghahambing\",\n    \"definition\": \"Paraan ng paglalahad na nagpapakita ng pagkakaiba at pagkakatulad sa pagitan ng dalawa o higit pang bagay, konsepto, o pangyayari.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Pagbibigay-Depinisyon\",\n    \"definition\": \"Paraan ng paglalahad na nagpapaliwanag ng kahulugan ng isang salita, termino, o konsepto — konkreto man o abstrakto; mahalagang pag-ibahin ang kahulugang denotatibo at konotatibo.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Paglilista ng Klasipikasyon\",\n    \"definition\": \"Paraan ng paglalahad na naghahati-hati ng isang malaking paksa o ideya sa iba't ibang kategorya o grupo upang magkaroon ng sistema ang pagtalakay.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Pangunahing Ideya\",\n    \"definition\": \"Elemento ng tekstong impormatibo na dagliang inilalahad sa mambabasa.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Pantulong sa Kaisipan\",\n    \"definition\": \"Mga detalyeng tumutulong ibuo sa isip ang pangunahing ideya ng isang teksto.\"\n  },\n  {\n    \"chapterId\": \"ch3\",\n    \"term\": \"Tuwirang at Hindi Tuwirang Impormasyon\",\n    \"definition\": \"Ang tuwirang impormasyon ay mula mismo sa may-karanasan o saksi; ang hindi tuwiran naman ay nagmula sa ikinuwento ng iba.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Tekstong Deskriptibo\",\n    \"definition\": \"Tekstong may layuning maglarawan ng isang bagay, tao, lugar, karanasan, o sitwasyon; gumagamit ng pang-uri, pang-abay, at tayutay; epektibo kapag napupukaw ang limang pandama.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Obhetibong Paglalarawan\",\n    \"definition\": \"Direktang pagpapakita ng katangian na makatotohanan at di mapasusubalian — nakabatay sa katotohanan sa totoong buhay.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Subhetibong Paglalarawan\",\n    \"definition\": \"Paglalarawang may pagkiling sa sariling damdamin at nakabatay lamang sa imahinasyon ng manunulat, hindi sa katotohanan.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Reperensiya (Reference)\",\n    \"definition\": \"Paggamit ng panghalip o salitang pantukoy (siya, sila, ito, iyon) upang tukuyin ang tao, bagay, o ideya; may anapora at katapora.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Anapora at Katapora\",\n    \"definition\": \"Mga uri ng reperensiya. Ang anapora ay bumabalik sa naunang tinukoy; ang katapora ay nauuna ang panghalip bago malaman ang tinutukoy.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Substitusyon\",\n    \"definition\": \"Paggamit ng ibang salita bilang panghalili sa halip na ulitin ang parehong salita.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Elipsis\",\n    \"definition\": \"Pagbabawas ng ibang parte ng pangungusap nang hindi nababawasan ang diwa, dahil natutukoy ito sa naunang pahayag.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Pang-ugnay (Conjunction)\",\n    \"definition\": \"Paggamit ng pang-ugnay tulad ng at, ngunit, o, sapagkat, dahil, at kaya upang iugnay ang mga pangungusap, parirala, o sugnay.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Kohesyong Leksikal\",\n    \"definition\": \"Paggamit ng mabibisa at angkop na salita para sa magkakaugnay na daloy ng ideya; may dalawang uri: reiterasyon at kolokasyon.\"\n  },\n  {\n    \"chapterId\": \"ch4\",\n    \"term\": \"Reiterasyon at Kolokasyon\",\n    \"definition\": \"Mga uri ng kohesyong leksikal. Ang reiterasyon ay pag-uulit o repetisyon, pag-iisa-isa, at pagbibigay-kahulugan; ang kolokasyon ay mga salitang karaniwang magkapareha, gaya ng guro–mag-aaral at doktor–pasyente.\"\n  }\n]","filePath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\enc234.json"},"output":"Wrote file successfully.","metadata":{"diagnostics":{},"filepath":"C:\\Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\enc234.json","exists":false,"truncated":false},"title":"Users\\kelly\\AppData\\Local\\Temp\\opencode\\pwso_frags\\enc234.json","time":{"start":1789888110757,"end":1789888110771}},"id":"prt_0bda4e64c0018U9w93FQPvTJP3","sessionID":"ses_f42685812ffeYBxHvYBLR3HFUo","messageID":"msg_0bda4d016001DegqMRLfuKJH8n"}}
