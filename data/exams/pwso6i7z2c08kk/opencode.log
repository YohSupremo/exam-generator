COMMAND: "C:/Users/kelly/AppData/Roaming/npm/node_modules/opencode-ai/bin/opencode.exe" run --format json --auto --dir "C:/xampp/htdocs/automation/side-project" --file "C:/xampp/htdocs/automation/side-project/data/exams/pwso6i7z2c08kk/source.txt" --title "PAGPAG-REVIEWER" "You are generating an interactive comprehensive exam system for a web app.

