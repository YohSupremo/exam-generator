# ===================================================
# Auto Exam Maker - AI Provider Credentials
# ===================================================

# Groq API Key (Recommended - Free, instant, high rate limits)
# Get yours at https://console.groq.com/
GROQ_API_KEY=

# OpenRouter API Key (Alternative for dozens of free models)
# Get yours at https://openrouter.ai/
# OPENROUTER_API_KEY=

# Google Gemini API Key
# Get yours at https://aistudio.google.com/
# GEMINI_API_KEY=

# Override default model (optional):
# For Groq: groq/openai/gpt-oss-120b or groq/openai/gpt-oss-20b
# For OpenRouter: openrouter/meta-llama/llama-3.3-70b-instruct:free
# OPENCODE_MODEL=groq/openai/gpt-oss-120b
